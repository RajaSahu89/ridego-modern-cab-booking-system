# --- Database (PostgreSQL) ---
# Option A: Postgres installed on your own PC. Replace YOUR_PASSWORD with the password you chose
# when installing PostgreSQL. "npm run db:setup" creates the "ridego" database for you.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ridego
# Option B: a free hosted database (Supabase or Neon). Comment out the line above and paste its
# connection string here instead:
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Long random string used to sign logins. "npm run setup" fills this in for you.
JWT_SECRET=change-me-to-a-long-random-string

# Allowed frontend origins, comma-separated, no trailing slash. localhost always works in development.
CLIENT_URL=http://localhost:5173
PORT=4000
